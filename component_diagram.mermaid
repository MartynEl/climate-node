graph TD
    subgraph Hardware ["Hardware: STM32F103"]
        CPU[Cortex-M3 Core]
        FLASH[Flash Memory]
        RAM[SRAM]
        UART_HW[USART1 Peripheral]
        IWDG_HW[IWDG Watchdog]
        GPIO_HW[GPIO Ports]
        I2C_HW[I2C Peripheral]
    end

    subgraph BSP_Layer ["BSP / Drivers: Hardware Specific"]
        Startup[startup_stm32f1.c<br/>Vector Table + Reset Handler]
        LinkerScript[stm32f103c8tx.ld<br/>Memory Layout Config]
        UartDrv[uart.c<br/>Reg Access + Ring Buffers<br/>RS485 Direction Control]
        PlatStm32[platform_stm32f1.c<br/>SysTick Impl + IWDG Impl<br/>Flash Read/Write Stub]
        I2CDrv[i2c_stubs.c / sht31_driver<br/>I2C Bit-banging or HW Init]
    end

    subgraph Platform_Abs ["Platform Abstraction Interfaces"]
        PlatHeader[platform.h<br/>millis wfi relay_set wdg_feed]
        SensorPort[sensor.h<br/>sensor_port_t interface]
        StorageAPI[storage.h<br/>load save finalize]
    end

    subgraph Core_Logic ["Core Business Logic: Portable C"]
        Controller[controller.c<br/>FSM Hysteresis Fault Handling]
        Dewpoint[dewpoint.c<br/>Magnus Formula Fixed-Point Math]
        Filter[filter.c<br/>Moving Average MA]
        Diagnostics[diagnostics.c<br/>Counters Uptime Tracking]
        Errors[errors.c<br/>Enum Definitions]
    end

    subgraph Services ["Services: Infrastructure"]
        ModbusServer[modbus_server.c<br/>Frame Assembly Timeout Detection]
        ModbusRegs[modbus_regs.c<br/>Register Mapping]
        Logger[logger.c<br/>Ring Buffer Formatting]
        StorageImpl[storage.c<br/>CRC32 Validation Slot Mgmt]
    end

    subgraph App_Layer ["Application Layer: Glue Code"]
        MainMCU[main_mcu.c<br/>Init Sequence Superloop]
        AppStruct[app.c<br/>Composition Root Ticket Mgmt]
        Scheduler[scheduler.c<br/>Cooperative Task Runner]
    end

    %% Dependencies
    MainMCU --> AppStruct
    MainMCU --> Scheduler
    MainMCU --> ModbusServer
    MainMCU --> Logger
    
    AppStruct --> Controller
    AppStruct --> StorageImpl
    AppStruct --> PlatHeader
    
    Scheduler -.->|calls| MainMCU_tasks((Tasks))
    
    Controller --> Dewpoint
    Controller --> Filter
    Controller --> SensorPort
    
    Dewpoint --> LUT[dewpoint_lut.h<br/>Generated by Python Script]
    
    ModbusServer --> ModbusRegs
    ModbusServer --> UART_RX(uart1_rx_pop)
    ModbusServer --> UART_TX(uart1_tx_bytes)
    
    StorageImpl --> PlatFlash(platform_flash_read/write)
    PlatFlash -.-> FLASH
    
    PlatHeader -.-> SysTickImpl(SYSTICK_IMPL)
    PlatHeader -.-> WDGImpl(IWDG_IMPL)
    PlatHeader -.-> RelayImpl(GPIO_WRITE)
    
    UartDrv --> UART_HW
    UartDrv --> GPIO_HW
    PlatStm32 --> IWDG_HW
    PlatStm32 --> CPU
    
    style Core_Logic fill:#e1f5fe,stroke:#01579b,color:black
    style BSP_Layer fill:#fff3e0,stroke:#e65100,color:black
    style App_Layer fill:#f3e5f5,stroke:#4a148c,color:black
    style Hardware fill:#eceff1,stroke:#37474f,color:black
    style Services fill:#e8f5e9,stroke:#1b5e20,color:black
    style Platform_Abs fill:#fce4ec,stroke:#880e4f,color:black